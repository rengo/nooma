package ui

import "github.com/rengo/nooma/internal/brain"

// BeliefsPage is GET /ui/beliefs' full page.
templ BeliefsPage(groups []brain.FacetBeliefs, res *beliefResult) {
	@Page("nooma — beliefs", beliefsBody(groups, res))
}

templ beliefsBody(groups []brain.FacetBeliefs, res *beliefResult) {
	<section>
		<h2>BELIEFS</h2>
	</section>
}
