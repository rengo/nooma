package ui

import (
	"context"
	"fmt"
	"strconv"
	"time"

	"github.com/rengo/nooma/internal/brain"
	"github.com/rengo/nooma/internal/core/focus"
	"github.com/rengo/nooma/internal/core/prospection"
	"github.com/rengo/nooma/internal/ports"
)

// Today is what GET /ui renders once a TodayReader is wired (design m4a
// §3.6, §7.2's PR 7 tip row): FOCUS over both focus.Kind sections, PENDING
// DIGEST exactly as Carry left it, and SYSTEM's six lines. It renders
// brain.Today directly — no second, hand-mapped view-model type between the
// service and this template (§3.1's own ruling that ui imports brain only
// for its output types).
templ Today(today brain.Today, serving Serving) {
	@Page("nooma", todayBody(today, serving, nil))
}

// TodayAnswered is Today after its question was answered from the page, with
// the answer's notice above it.
templ TodayAnswered(today brain.Today, serving Serving, notice graphNotice) {
	@Page("nooma", todayBody(today, serving, &notice))
}

templ todayBody(today brain.Today, serving Serving, notice *graphNotice) {
	<div id="today-result" aria-live="polite">
		if notice != nil {
			<p data-outcome={ notice.Outcome }>{ notice.Message }</p>
		}
	</div>
	<div data-grid>
		for _, f := range today.Focuses {
			<section data-focus={ string(f.Kind) }>
				<h2>{ "FOCUS: " + string(f.Kind) }</h2>
				if len(f.Members) == 0 {
					<p data-empty>{ focusEmpty(f.Kind) }</p>
				}
				<ol>
					for _, m := range f.Members {
						<li>
							<a href={ templ.URL("/ui/units/" + m.ID) }>{ m.Content }</a>
							if m.DueAt != nil {
								<span>Due: { formatTime(ctx, *m.DueAt) }</span>
							}
							if m.EventAt != nil {
								<span>Event: { formatTime(ctx, *m.EventAt) }</span>
							}
							<span data-score title="focus score">score { formatScore(m.Score) }</span>
						</li>
					}
				</ol>
			</section>
		}
		<section data-view="digest">
			<h2>PENDING DIGEST</h2>
			if len(today.Digest.Items) == 0 && today.Digest.Question == nil && today.Digest.Goal == "" {
				if today.Digest.Held > 0 {
					<p data-empty>{ fmt.Sprintf("Nothing for the next digest yet; %d held for later.", today.Digest.Held) }</p>
				} else {
					<p data-empty>The next morning digest has nothing to carry yet.</p>
				}
			}
			<ul>
				for _, line := range today.Digest.Items {
					<li>{ line.Text }</li>
				}
			</ul>
			if today.Digest.Question != nil {
				@todayQuestion(*today.Digest.Question)
			}
			if today.Digest.Goal != "" {
				<p data-goal>{ today.Digest.Goal }</p>
			}
			<p data-held>{ fmt.Sprintf("Held: %d", today.Digest.Held) }</p>
		</section>
		if len(today.Upcoming) > 0 {
			<section data-view="upcoming">
				<h2>UPCOMING REMINDERS</h2>
				<ul>
					for _, line := range today.Upcoming {
						<li>{ line.Text + " — " + formatTime(ctx, line.FireAt) }</li>
					}
				</ul>
			</section>
		}
		<section data-view="system">
			<h2>SYSTEM</h2>
			<ul>
				<li>{ "Last consolidation: " + formatConsolidation(ctx, today.Status.LastConsolidationAt) }</li>
				<li>{ "Energy: " + formatEnergy(ctx, today.Status.Energy) }</li>
				<li>{ fmt.Sprintf("Undelivered: %d", today.Status.Undelivered) }</li>
				<li>{ fmt.Sprintf("Open questions: %d", today.Status.OpenQuestions) }</li>
				<li>{ "Bind: " + serving.Bind }</li>
				<li>{ "Cookie auth: " + formatCookieAuth(serving.CookieAuth) }</li>
			</ul>
		</section>
	</div>
}

// todayQuestion is the question the next digest asks, answerable here by its
// id (I09): yes confirms the link, no deletes it, as the chat's answer does.
templ todayQuestion(q ports.RelationQuestion) {
	<div data-question-id={ q.ID }>
		<p data-question>{ "Question: " + q.FromContent + " — " + q.ToContent }</p>
		<p>Are these two related?</p>
		<form method="post" action={ templ.URL("/ui/questions/" + q.ID + "/confirm") } hx-boost="true" hx-disabled-elt="find button[type=submit]" hx-sync="this:drop">
			<button type="submit">
				@submitLabel("Yes, they are", "Confirming…")
			</button>
		</form>
		<form method="post" action={ templ.URL("/ui/questions/" + q.ID + "/reject") } hx-boost="true" hx-disabled-elt="find button[type=submit]" hx-sync="this:drop">
			<button type="submit">
				@submitLabel("No, delete the link", "Deleting…")
			</button>
		</form>
	</div>
}

// focusEmpty is a focus list's empty state: what would put something there.
func focusEmpty(k focus.Kind) string {
	if k == focus.KindLoad {
		return "Nothing is weighing on you. Worries and open loops you capture show up here."
	}
	return "Nothing needs your attention right now. Capture a task or an event and it shows up here."
}

// dateLayout is today.templ's one date format — I18's distinct labels
// (Due:/Event:) are what keeps the two kinds from being confused; the
// layout itself just needs to be readable.
const dateLayout = "2006-01-02 15:04"

// formatScore renders focus.Rank's own literal Score — NaN included, never
// coerced (Q7, ruled, design §11): two decimals, or the literal "NaN".
// No NaN branch lives here — strconv.FormatFloat renders NaN as "NaN"
// itself, so a branch would be dead code claiming to guard something.
// The guard is TestTodayView_RendersThreeSectionsFromTheModel asserting
// the rendered text: coercing NaN to "0.00" fails it (verified).
func formatScore(s float64) string {
	return strconv.FormatFloat(s, 'f', 2, 64)
}

func formatConsolidation(ctx context.Context, t *time.Time) string {
	if t == nil {
		return "never"
	}
	return formatTime(ctx, *t)
}

func formatEnergy(ctx context.Context, e *prospection.EnergyReading) string {
	if e == nil {
		return "no reading"
	}
	return fmt.Sprintf("%.2f (%s, %s)", e.Level, e.Source, formatTime(ctx, e.RecordedAt))
}

func formatCookieAuth(on bool) string {
	if on {
		return "enabled"
	}
	return "disabled"
}
