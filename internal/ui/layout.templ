package ui

// Page is internal/ui's one layout: the <html> shell every view renders
// inside. The htmx-config meta tag is CSP-compatible (no inline script),
// per design m4a §3.5; the stylesheet is a static asset served from
// /ui/static, never inlined, for the same reason. responseHandling swaps
// every response into its target regardless of status code (design §3.5,
// OR7): without it htmx's own default only swaps 2xx/3xx, so a capture
// form's 400/503/500 fragment would never reach #capture-result at all.
templ Page(title string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ `{"allowEval":false,"includeIndicatorStyles":false,"responseHandling":[{"code":"...","swap":true}]}` }/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/ui/static/app.css"/>
		</head>
		<body>
			<header>
				<nav aria-label="Main">
					<span data-brand>nooma</span>
					for _, item := range navItems {
						if item.current(title) {
							<a href={ templ.URL(item.href) } aria-current="page">{ item.label }</a>
						} else {
							<a href={ templ.URL(item.href) }>{ item.label }</a>
						}
					}
				</nav>
			</header>
			<main>
				@body
			</main>
			if note := zoneNote(ctx); note != "" {
				<footer><small>{ note }</small></footer>
			}
			<script src="/ui/static/htmx.min.js"></script>
		</body>
	</html>
}

// navItem is one top-nav entry. A page is the current one when its title
// names it; the unit detail page belongs to Units.
type navItem struct {
	href, label string
	titles      []string
}

func (n navItem) current(title string) bool {
	for _, t := range n.titles {
		if t == title {
			return true
		}
	}
	return false
}

var navItems = []navItem{
	{href: "/ui", label: "Today", titles: []string{"nooma"}},
	{href: "/ui/units", label: "Units", titles: []string{"nooma — units", "nooma — unit"}},
	{href: "/ui/capture", label: "Capture", titles: []string{"nooma — capture"}},
	{href: "/ui/beliefs", label: "Beliefs", titles: []string{"nooma — beliefs"}},
	{href: "/ui/activity", label: "Activity", titles: []string{"nooma — activity"}},
}
