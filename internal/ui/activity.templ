package ui

import (
	"time"

	"github.com/rengo/nooma/internal/brain"
)

// ActivityPage is GET /ui/activity's full page: the family filter, the rows
// newest first and, only when older rows exist, a link to them.
templ ActivityPage(page brain.ActivityPage, kind string, families []string) {
	@Page("nooma — activity", activityBody(page, kind, families))
}

// The only form on the page is the GET filter: no row carries a control, so a
// previous value is shown and never offered back (m4e-activity design G8).
templ activityBody(page brain.ActivityPage, kind string, families []string) {
	<section>
		<h2>ACTIVITY</h2>
		<form method="get" action="/ui/activity">
			<label for="kind">Kind</label>
			<select id="kind" name="kind">
				<option value="" selected?={ kind == "" }>All</option>
				for _, f := range families {
					<option value={ f } selected?={ f == kind }>{ f }</option>
				}
			</select>
			<button type="submit">Filter</button>
		</form>
		if len(page.Rows) == 0 {
			if kind == "" {
				<p data-empty>Nothing recorded yet. Every capture, reminder and overnight change will be listed here, with the reason for it.</p>
			} else {
				<p data-empty>Nothing of this kind has been recorded yet.</p>
			}
		}
		<ol data-timeline>
			for _, row := range page.Rows {
				<li data-decision-id={ row.ID }>
					<p data-headline>
						<strong>{ activityTitle(row.Action) }</strong>
						if row.Subject != nil {
							<a href={ templ.URL("/ui/units/" + row.Subject.UnitID) }>{ row.Subject.Content }</a>
						}
					</p>
					<time datetime={ row.OccurredAt.UTC().Format(time.RFC3339) }>{ formatTime(ctx, row.OccurredAt) }</time>
					if len(row.Change) > 0 {
						<ul data-change>
							for _, c := range row.Change {
								<li data-field={ c.Name } data-previous={ c.Previous } data-next={ c.Next }><span>{ fieldLabel(c.Name) }</span> <del>{ localizeInstant(ctx, c.Previous) }</del> → <ins>{ localizeInstant(ctx, c.Next) }</ins></li>
							}
						</ul>
					}
					<p data-rationale>{ localizeProse(ctx, row.Rationale) }</p>
					<code>{ string(row.Action) }</code>
				</li>
			}
		</ol>
		if page.Next != nil {
			<a href={ templ.URL(olderURL(kind, page.Next)) } rel="next">Older</a>
		}
	</section>
}
