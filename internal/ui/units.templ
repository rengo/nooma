package ui

import (
	"github.com/rengo/nooma/internal/core/unit"
	"github.com/rengo/nooma/internal/ports"
)

// UnitsPage is GET /ui/units' full page: the search box and the first page
// of rows (design §3.2, §3.4), each row anchored to its own unit's detail
// path (design §5, PR 4).
templ UnitsPage(units []unit.Unit, next *ports.BrowseCursor, types []string) {
	@Page("nooma — units", unitsBody(units, next, types))
}

templ unitsBody(units []unit.Unit, next *ports.BrowseCursor, types []string) {
	<section>
		<h2>UNITS</h2>
		<form role="search" hx-get="/ui/units" hx-target="#units-rows" hx-swap="innerHTML">
			<label for="q">Search</label>
			<input type="search" id="q" name="q" placeholder="search live units"/>
			<button type="submit">Search</button>
		</form>
		<div id="units-rows">
			@unitsRows(units, next, types)
		</div>
	</section>
}

// unitsRows is the rows fragment alone — what an HX-Request answer carries,
// and what unitsBody wraps for a full page load. Every row's own unit id
// travels as data-unit-id, this view's structural marker, not its own
// escaped text.
templ unitsRows(units []unit.Unit, next *ports.BrowseCursor, types []string) {
	if len(units) == 0 {
		<p data-empty>No units here yet. Capture a thought, a task or an event and it is listed here; a search that finds nothing ends here too.</p>
	}
	<ul>
		for _, u := range units {
			<li data-unit-id={ u.ID }>
				<a href={ templ.URL("/ui/units/" + u.ID) }>{ u.Content }</a>
				<span>{ string(u.Type) }</span>
				if u.EventAt != nil {
					<small>Event: { formatTime(ctx, *u.EventAt) }</small>
				} else if u.DueAt != nil {
					<small>Due: { formatTime(ctx, *u.DueAt) }</small>
				}
			</li>
		}
	</ul>
	if next != nil {
		<a hx-get={ moreURL(types, next) } hx-target="#units-rows" hx-swap="innerHTML">More</a>
	}
}
