package ui

import "github.com/rengo/nooma/internal/brain"

// TimersPage is GET /ui/timers' full page: the live timers, soonest first,
// each with its cancel.
templ TimersPage(live []brain.ListedTimer, notice *graphNotice) {
	@Page("nooma — timers", timersBody(live, notice))
}

templ timersBody(live []brain.ListedTimer, notice *graphNotice) {
	<section data-view="timers">
		<h2>TIMERS</h2>
		<div id="timers-result" aria-live="polite">
			if notice != nil {
				<p data-outcome={ notice.Outcome }>{ notice.Message }</p>
			}
		</div>
		if len(live) == 0 {
			<p data-empty>No timer is set. Ask Nooma to remind you in a few minutes and it shows up here.</p>
		}
		<ul data-timers>
			for _, t := range live {
				<li data-timer-id={ t.ID }>
					<span>{ timerLine(ctx, t) }</span>
					<form method="post" action={ templ.URL("/ui/timers/" + t.ID + "/cancel") } hx-boost="true" hx-disabled-elt="find button[type=submit]" hx-sync="this:drop">
						<button type="submit">
							@submitLabel("Cancel", "Cancelling…")
						</button>
					</form>
				</li>
			}
		</ul>
	</section>
}
