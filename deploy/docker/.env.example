# Copy to deploy/docker/.env (gitignored) and fill in. These values reach the
# container's environment, where they win over the vault's own .env. The
# names must match nooma.yml: api_key_env, bot_token_env, auth_token_env.

# The provider key (nooma.yml: providers.*.api_key_env).
OPENAI_API_KEY=

# The Telegram bot token (nooma.yml: channels.telegram.bot_token_env).
# The allowed chat ids are not a secret: they live in nooma.yml.
TELEGRAM_BOT_TOKEN=

# The server token (nooma.yml: server.auth_token_env). Mandatory: inside the
# container serve binds 0.0.0.0, and a non-loopback bind without a token does
# not start (ADR-0007). Generate one with: openssl rand -hex 32
NOOMA_AUTH_TOKEN=

# The release compose.yml runs, without its v (0.5.0, 1.0.0-rc.1). Empty
# means latest, the newest release that is not a release candidate.
NOOMA_VERSION=
